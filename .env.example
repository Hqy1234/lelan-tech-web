# ============================================================================
# LELAN TECHNOLOGY · 环境变量示例
# ============================================================================
#
# 复制为 .env.local（本地）或配置到 deployment 环境（生产）。
#
# ⚠ 本文件只包含【变量名】与【非敏感默认值】。
#    真实密钥绝不写入本文件、绝不提交 Git。
#
# .gitignore 中的 `.env*` 会忽略所有 .env 文件；
# 本文件通过 `!.env.example` 例外被允许提交。
# ============================================================================


# ---------------------------------------------------------------------------
# Guardian Analysis Adapter（独立部署的 server-side Adapter）
# ---------------------------------------------------------------------------
#
# ⚠ 以下两项属于【Adapter 服务】的服务器环境变量，
#    不是官网构建变量。它们必须配置在 Adapter 服务的运行环境中，
#    绝不能出现在官网仓库、浏览器或 NEXT_PUBLIC_* 中。
#
# DIFY_API_KEY=            # 真实 Key 只在 Adapter 服务的部署环境里配置
# DIFY_API_BASE_URL=https://api.dify.ai/v1


# ---------------------------------------------------------------------------
# 官网（静态导出）使用的公开配置
# ---------------------------------------------------------------------------
#
# Adapter 的公开 URL。这是【地址】而非密钥，可以出现在浏览器中。
# 留空 = 关闭智能分析（官网完全回退到现有确定性行为，不会报错）。
#
# 本地开发： http://127.0.0.1:8787
# 生产：     https://<your-adapter-service-domain>
#
NEXT_PUBLIC_GUARDIAN_ADAPTER_URL=
