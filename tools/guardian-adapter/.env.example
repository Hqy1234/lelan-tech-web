# ============================================================================
# Guardian Analysis Adapter · 服务器环境变量示例
# ============================================================================
#
# 复制为 .env（本地）或配置到 Adapter 服务的 deployment 环境（生产）。
#
# ⚠ 本文件只含变量名与公开默认值。真实 Key 绝不写入本文件。
# ============================================================================

# Dify Workflow API Key（必填，机密）
# 形如 app-xxxxxxxxxxxxxxxx
DIFY_API_KEY=

# Dify API 基址（必填）
DIFY_API_BASE_URL=https://api.dify.ai/v1

# 监听端口（可选，默认 8787）
PORT=8787

# 允许的浏览器来源，逗号分隔（可选）
# 本地开发建议： http://localhost:3000,http://127.0.0.1:5000
# 生产：填写官网的正式域名
ALLOWED_ORIGINS=

# Dify blocking 请求超时，毫秒（可选，默认 25000）
DIFY_TIMEOUT_MS=40000
