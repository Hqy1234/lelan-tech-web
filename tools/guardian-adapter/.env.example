# ============================================================================
# Guardian Analysis Adapter · 服务器环境变量示例
# ============================================================================
#
# 复制为 .env（本地）或配置到 Adapter 服务的 deployment 环境（生产）。
#
# ⚠ 本文件只含变量名与公开默认值。真实 Key 绝不写入本文件。
# ============================================================================

# Dify Workflow API Key（必填，机密）
# 形态为 "app-" 前缀加一串字符。此处不写出任何真实形态的示例，避免误当真值。
DIFY_API_KEY=

# Dify API 基址（必填）
DIFY_API_BASE_URL=https://api.dify.ai/v1

# 监听端口（可选，默认 8787）
PORT=8787

# 允许的浏览器来源，逗号分隔
#
# ⚠ 生产环境（NODE_ENV=production）此项【必填】：
#    缺失或为空时 Adapter 直接拒绝启动（exit 1）。
#    无 allow-list 就没有安全默认值 —— 允许任意来源，或回显任意 Origin，
#    等于让任何网站用我们的 Dify 凭据驱动该服务。
#
# 开发环境可留空：仅表示不向任何浏览器来源授予 CORS（服务间调用仍可用）。
#
# 本地开发建议： http://localhost:3000,http://127.0.0.1:5100
# 生产示例：     https://www.example.com,https://example.com
ALLOWED_ORIGINS=

# Dify blocking 请求【总预算】，毫秒（可选，默认 40000）
#
# 注意：这是跨尝试共享的总预算，不是每次尝试的超时。
# 官网客户端超时为 50s，必须大于此值，否则浏览器会先 abort，
# 用户看到的将是通用网络错误而不是结构化超时提示。
#
# Workflow 单次运行 >20s 属于 Dify 侧的 optimization issue，
# 不应靠继续放大客户端超时来掩盖。
DIFY_TIMEOUT_MS=40000
